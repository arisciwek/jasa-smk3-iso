---
import BaseLayout from './BaseLayout.astro';

const { title, description } = Astro.props;

// Jika ada front-matter title/description, gunakan; else gunakan default
const articleTitle = title ?? 'Artikel K3';
const articleDescription = description ?? 'Rujukan teknis Sistem Manajemen K3 & ISO 45001';
---

<BaseLayout title={articleTitle} description={articleDescription}>
  <article class="prose prose-lg mx-auto my-8 max-w-2xl">
    <slot />
  </article>

  {/* Opsional: tambahan di bawah artikel, misalnya related posts */}
  {/* <section class="mt-12">
    <h2 class="text-2xl font-semibold mb-4">Baca Juga</h2>
    <ul class="list-disc pl-5 space-y-2">
      {/*
        Anda bisa menambahkan logika related posts di sini jika ingin.
      */}
    </ul>
  </section> */}
</BaseLayout>