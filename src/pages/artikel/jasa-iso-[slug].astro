---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { cities } from '../../data/cities';
import { getCityIsoFaqs } from '../../data/faqs';
import { site } from '../../data/site';

const cityContentFiles = import.meta.glob('../../data/jasa-iso/*.json', {
  eager: true,
  import: 'default',
});

export async function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const cityContent = cityContentFiles[`../../data/jasa-iso/${city.slug}.json`] ?? {
  lastmod: undefined,
  paragraphs: [],
};
const cityFaqs = [...getCityIsoFaqs(city.name), ...(cityContent.faqs ?? [])];

const title = `Jasa Sertifikasi ISO di ${city.name} - ${site.phone}`;
const description = `Layanan pendampingan sertifikasi ISO 45001, ISO 9001, ISO 14001, ISO 27001, dan standar ISO lainnya di ${city.name}. Konsultan sistem manajemen siap bantu gap analysis, dokumen sistem, audit internal, hingga persiapan audit sertifikasi eksternal. Hubungi ${site.phone}.`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Jasa Sertifikasi ISO di ${city.name}`,
  serviceType: 'Pendampingan Sistem Manajemen ISO',
  description,
  image: new URL('/assets/images/article-lokasi-smk3.svg', Astro.site ?? Astro.url).href,
  provider: { '@type': 'Organization', name: site.company },
  areaServed: { '@type': 'City', name: city.name },
  ...(cityContent.lastmod ? { dateModified: cityContent.lastmod } : {}),
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
};

const isoStandards = [
  { slug: 'iso-45001', name: 'ISO 45001:2018', category: 'K3', summary: 'Sistem manajemen keselamatan dan kesehatan kerja berbasis risiko.' },
  { slug: 'iso-9001', name: 'ISO 9001:2015', category: 'Mutu', summary: 'Sistem manajemen mutu untuk kepuasan pelanggan dan peningkatan berkelanjutan.' },
  { slug: 'iso-14001', name: 'ISO 14001:2015', category: 'Lingkungan', summary: 'Sistem manajemen lingkungan untuk pengendalian dampak operasional.' },
  { slug: 'iso-27001', name: 'ISO/IEC 27001:2022', category: 'Keamanan Informasi', summary: 'Sistem manajemen keamanan informasi melindungi kerahasiaan, integritas, ketersediaan.' },
  { slug: 'iso-22000', name: 'ISO 22000:2018', category: 'Keamanan Pangan', summary: 'Sistem manajemen keamanan pangan sepanjang rantai makanan.' },
  { slug: 'iso-37001', name: 'ISO 37001:2016', category: 'Anti Suap', summary: 'Sistem manajemen antisuap untuk pencegahan, deteksi, dan penanganan risiko penyuapan.' },
  { slug: 'iso-55001', name: 'ISO 55001:2014', category: 'Manajemen Aset', summary: 'Sistem manajemen aset sepanjang siklus hidup berdasarkan biaya, risiko, dan kinerja.' },
  { slug: 'iso-28000', name: 'ISO 28000:2022', category: 'Keamanan Rantai Pasok', summary: 'Sistem manajemen keamanan rantai pasok untuk kesiapsiagaan dan ketahanan operasional.' },
  { slug: 'iso-13485', name: 'ISO 13485:2016', category: 'Alat Kesehatan', summary: 'Sistem manajemen mutu untuk organisasi alat kesehatan.' },
  { slug: 'iso-17025', name: 'ISO/IEC 17025:2017', category: 'Laboratorium', summary: 'Akreditasi laboratorium pengujian dan kalibrasi.' },
  { slug: 'iso-21001', name: 'ISO 21001:2018', category: 'Pendidikan', summary: 'Sistem manajemen organisasi pendidikan dan pelatihan.' },
  { slug: 'iatf-16949', name: 'IATF 16949', category: 'Otomotif', summary: 'Sistem manajemen mutu khusus industri otomotif.' },
  { slug: 'api-q1', name: 'API Q1', category: 'Migas Produk', summary: 'Sistem manajemen mutu produk industri minyak dan gas.' },
  { slug: 'api-q2', name: 'API Q2', category: 'Migas Jasa', summary: 'Sistem manajemen mutu jasa teknis industri minyak dan gas.' },
];

const processSteps = [
  { title: 'Gap Analysis dan Pemetaan Awal', desc: 'Identifikasi kesenjangan antara kondisi saat ini dengan persyaratan standar ISO yang ditargetkan. Pemetaan proses, risiko, dan dokumentasi yang sudah ada.' },
  { title: 'Penyusunan Dokumen Sistem', desc: 'Membuat atau menyesuaikan manual, prosedur, instruksi kerja, formulir, dan rekaman sesuai klausul standar. Fokus pada dokumen yang dipakai, bukan sekadar memenuhi syarat.' },
  { title: 'Penerapan, Audit Internal, dan Persiapan Sertifikasi', desc: 'Pelaksanaan sistem di lapangan, pelatihan personel, audit internal oleh auditor terlatih, tinjauan manajemen, dan persiapan bukti untuk audit sertifikasi eksternal.' },
  { title: 'Tindak Lanjut Pasca Sertifikasi', desc: 'Pemeliharaan sistem, audit surveilans, perbaikan berkelanjutan, dan penyesuaian saat standar atau organisasi berubah.' },
];
---

<BaseLayout
  title={title}
  description={description}
  image="/assets/images/article-lokasi-smk3.svg"
  lastmod={cityContent.lastmod}
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Artikel', url: '/artikel/' }, { name: `Jasa Sertifikasi ISO di ${city.name}`, url: Astro.url.pathname }]}
  footerBrandDescription={`PT. PEI Sinergi Indonesia menyelenggarakan jasa sertifikasi ISO di ${city.name}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <main class="content-section">
    <div style="max-width: 800px; margin: 0 auto;">
      <header style="margin-bottom: 1.5rem;">
        <div class="hero-tag">// LAYANAN LOKAL ISO</div>
        <h1 style="font-size: 2.2rem; margin-top: 0; margin-bottom: 0.75rem;">Jasa Sertifikasi ISO di {city.name}</h1>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6;">
          Kami menyediakan <strong>pendampingan sertifikasi ISO di {city.name}</strong> meliputi ISO 45001 (K3), ISO 9001 (Mutu), ISO 14001 (Lingkungan), ISO 27001 (Keamanan Informasi), ISO 22000 (Keamanan Pangan), ISO 37001 (Anti Suap), ISO 55001 (Aset), ISO 28000 (Rantai Pasok), ISO 13485 (Alat Kesehatan), ISO 17025 (Laboratorium), ISO 21001 (Pendidikan), IATF 16949 (Otomotif), serta API Q1/Q2 (Migas). Tim konsultan kami membantu dari gap analysis hingga sertifikat terbit.
        </p>
      </header>

      <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <img
          src={`/assets/images/jasa-iso/jasa-iso-${city.slug}.svg`}
          alt={`Ilustrasi layanan sertifikasi ISO onsite di ${city.name}, ${city.region}`}
          width="160"
          height="96"
          loading="lazy"
        />
        <div style="flex: 1;">
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem; line-height: 1.5;">
            Layanan kami mencakup seluruh wilayah <strong>{city.name} ({city.region})</strong> dengan tim konsultan yang memahami konteks regulasi dan industri setempat.
          </p>
        </div>
      </div>

      <article style="line-height: 1.7; font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem;">
        <h2 style="color: var(--text); font-size: 1.3rem; margin: 1rem 0 0.5rem 0;">Standar Sertifikasi yang Dampingi</h2>
        <p style="margin-bottom: 1rem; line-height: 1.6;">
          PT. PEI Sinergi Indonesia mendampingi organisasi di {city.name} untuk mencapai sertifikasi pada standar ISO internasional dan nasional berikut. Setiap standar memiliki fokus, klausul, dan bukti penerapan yang berbeda — kami menyesuaikan pendekatan dengan kebutuhan bisnis Anda, bukan menerapkan template kaku.
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
          {isoStandards.map((std) => (
            <div style="background: var(--surface); border: 1px solid var(--border); padding: 1rem; border-radius: 6px;">
              <h3 style="color: var(--text); font-size: 1rem; margin: 0 0 0.4rem 0;">{std.name}</h3>
              <span style="font-size: 0.75rem; color: var(--accent); background: var(--accent-glow); padding: 0.15rem 0.5rem; border-radius: 3px;">{std.category}</span>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0.5rem 0 0 0; line-height: 1.5;">{std.summary}</p>
            </div>
          ))}
        </div>
      </article>

      <article style="line-height: 1.7; font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem;">
        <h2 style="color: var(--text); font-size: 1.3rem; margin: 1rem 0 0.5rem 0;">Proses Pendampingan Sertifikasi</h2>
        <p style="margin-bottom: 1rem; line-height: 1.6;">
          Pendampingan kami tidak berhenti pada dokumen. Kami memastikan sistem manajemen benar-benar dijalankan, dipahami tim, dan siap diuji saat audit eksternal.
        </p>
        {processSteps.map((step) => (
          <section style="margin-bottom: 1.5rem;">
            <h3 style="color: var(--text); font-size: 1.1rem; margin: 0.75rem 0 0.4rem 0;">{step.title}</h3>
            <p style="margin: 0; line-height: 1.6;">{step.desc}</p>
          </section>
        ))}
      </article>

      {cityContent.paragraphs.length > 0 && (
        <section aria-label={`Konteks lokal ${city.name}`} style="line-height: 1.7; font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem;">
          <h2 style="color: var(--text); font-size: 1.3rem; margin: 1rem 0 0.5rem 0;">Konteks Lokal {city.name} dan Kesiapan Sertifikasi</h2>
          {cityContent.paragraphs.map((paragraph) => <p style="margin-bottom: 1rem; line-height: 1.6;">{paragraph.text}</p>)}
          <h3 style="color: var(--text); font-size: 1.1rem; margin: 1rem 0 0.4rem 0;">Tantangan Operasional Setempat</h3>
          <p style="margin: 0; line-height: 1.6;">
            Setiap kota memiliki karakteristik regulasi, industri dominan, dan ketersediaan sumber daya yang berbeda. Kami membantu organisasi di {city.name} memetakan tantangan ini — mulai dari akses ke auditor akreditasi, ketersediaan pelatihan kompeten, hingga koordinasi dengan instansi terkait — agar rencana sertifikasi realistis dan tidak terjebak asumsi.
          </p>
          <h3 style="color: var(--text); font-size: 1.1rem; margin: 1rem 0 0.4rem 0;">Kesiapan Pendampingan Onsite</h3>
          <p style="margin: 0; line-height: 1.6;">
            Untuk pendampingan onsite di {city.name}, kami menyiapkan jadwal kunjungan yang efisien, akses ke lokasi produksi/kantor, kontak personel kunci, dan bukti kerja yang dapat diverifikasi. Tujuannya: setiap kunjungan onsite menghasilkan keluaran nyata — bukan sekadar pertemuan formalitas.
          </p>
        </section>
      )}

      <FAQ items={cityFaqs} title={`FAQ Jasa Sertifikasi ISO di ${city.name}`} eyebrow={`// FAQ ${city.name.toUpperCase()}`} />
    </div>
  </main>
</BaseLayout>