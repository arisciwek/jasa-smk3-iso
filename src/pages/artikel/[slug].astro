---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePagination from '../../components/ArticlePagination.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).sort((a, b) =>
    (a.data.lastmod || a.data.date).localeCompare(b.data.lastmod || b.data.date)
  );

  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      article,
      previous: articles[index - 1],
      next: articles[index + 1],
    },
  }));
}

const { article, previous, next } = Astro.props;
const { Content } = await render(article);
const lastmod = article.data.lastmod || article.data.date;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const imageUrl = new URL(article.data.image || '/assets/images/icon-smk3.svg', Astro.site ?? Astro.url).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.date,
  dateModified: lastmod,
  author: { '@type': 'Person', name: article.data.author },
  image: imageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  publisher: { '@type': 'Organization', name: site.company },
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.image || '/assets/images/page-articles.svg'}
  imageAlt={article.data.imageAlt || `Ilustrasi ${article.data.title}`}
  imageWidth={320}
  imageHeight={200}
  ogType="article"
  datePublished={article.data.date}
  dateModified={lastmod}
  lastmod={lastmod}
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Artikel', url: '/artikel/' }, { name: article.data.title, url: Astro.url.pathname }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main class="content-section article-detail-page">
    <div class="article-detail-header">
      <div class="hero-tag">// {article.data.category}</div>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      <img class="article-detail-image" src={article.data.image || '/assets/images/page-articles.svg'} alt={article.data.imageAlt || `Ilustrasi ${article.data.title}`} width="640" height="360" />
      <div class="article-detail-meta">
        <span>Oleh {article.data.author}</span>
        <time datetime={lastmod}>Diperbarui {lastmod}</time>
        {article.data.readTime && <span>{article.data.readTime}</span>}
      </div>
    </div>
    <article class="article-prose">
      <Content />
      <ArticlePagination previous={previous} next={next} />
    </article>
  </main>
</BaseLayout>

<style>
  .article-detail-page { max-width: 850px; }
  .article-detail-header { padding: 3rem 0 2.5rem; border-bottom: 1px solid var(--border); }
  .article-detail-header h1 { margin: 0.75rem 0 1rem; max-width: 760px; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; }
  .article-detail-header p { max-width: 700px; color: var(--text-muted); font-size: 1.1rem; }
  .article-detail-image { display: block; width: 100%; height: auto; margin-top: 1.5rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .article-detail-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; margin-top: 1.5rem; color: var(--text-dim); font-family: var(--font-mono); font-size: 0.75rem; }
  .article-prose { max-width: 720px; padding: 2.5rem 0 4rem; color: var(--text-muted); line-height: 1.8; }
  .article-prose :global(h2) { margin: 2rem 0 0.75rem; color: var(--text); font-size: 1.5rem; line-height: 1.3; }
  .article-prose :global(p) { margin-bottom: 1rem; }
  .article-prose :global(ol), .article-prose :global(ul) { margin: 0 0 1rem 1.5rem; }
</style>
