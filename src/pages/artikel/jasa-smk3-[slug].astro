---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { cities } from '../../data/cities';
import { getCityFaqs } from '../../data/faqs';

const cityContentFiles = import.meta.glob('../../data/city-content/*.json', {
  eager: true,
  import: 'default',
});

export async function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const cityContent = cityContentFiles[`../../data/city-content/${city.slug}.json`] ?? {
  lastmod: undefined,
  paragraphs: [],
};
const cityFaqs = [...getCityFaqs(city.name), ...(cityContent.faqs ?? [])];
const title = `Jasa SMK3 di ${city.name} — Konsultan K3 Resmi`;
const description = `Jasa SMK3 di ${city.name} : Layanan pendampingan sertifikasi & konsultan Jasa SMK3 PP 50/2012.`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Jasa SMK3 di ${city.name}`,
  serviceType: 'Pendampingan SMK3 PP 50/2012',
  description,
  image: new URL('/assets/images/article-lokasi-smk3.svg', Astro.site ?? Astro.url).href,
  provider: { '@type': 'Organization', name: 'PT Konsultan K3 Utama' },
  areaServed: { '@type': 'City', name: city.name },
  ...(cityContent.lastmod ? { dateModified: cityContent.lastmod } : {}),
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
};
---

<BaseLayout
  title={title}
  description={description}
  image="/assets/images/article-lokasi-smk3.svg"
  lastmod={cityContent.lastmod}
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Artikel', url: '/artikel/' }, { name: `Jasa SMK3 di ${city.name}`, url: Astro.url.pathname }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <main class="content-section">
    <div style="max-width: 800px; margin: 0 auto;">
      <header style="margin-bottom: 1.5rem;">
        <div class="hero-tag">// LAYANAN LOKAL K3</div>
        <h1 style="font-size: 2.2rem; margin-top: 0; margin-bottom: 0.75rem;">Jasa SMK3 di {city.name}</h1>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6;">
          Kami menyediakan jasa konsultasi, penyusunan dokumen HIRADC, Manual K3, hingga pendampingan audit eksternal sertifikasi SMK3 PP 50/2012 untuk wilayah <strong style="color: var(--text);">{city.name}</strong> dan sekitarnya.
        </p>
      </header>

      <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <svg class="city-service-image" viewBox="0 0 160 96" role="img" aria-label={`Ilustrasi layanan SMK3 onsite di ${city.name}, ${city.region}`}><title>{`Ilustrasi layanan SMK3 onsite di ${city.name}, ${city.region}`}</title><rect width="160" height="96" rx="8" fill="var(--surface-card)"/><path d="M80 16c-18 0-32 14-32 32 0 22 32 40 32 40s32-18 32-40c0-18-14-32-32-32Z" fill="none" stroke="var(--accent)" stroke-width="6"/><circle cx="80" cy="48" r="10" fill="none" stroke="var(--text)" stroke-width="5"/><path d="M18 80h34m56 0h34" stroke="var(--text-muted)" stroke-width="5" stroke-linecap="round"/></svg>
        <div style="flex: 1;">
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem; line-height: 1.5;">
            Layanan kami mencakup seluruh wilayah <strong>{city.name} ({city.region})</strong> dengan tim konsultan lokal yang siap diterjunkan langsung ke workshop/pabrik/proyek Anda.
          </p>
        </div>
      </div>

      <article style="line-height: 1.7; font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem;">
        <h2 style="color: var(--text); font-size: 1.3rem; margin: 1rem 0 0.5rem 0;">Manfaat Layanan</h2>
        <p style="margin-bottom: 1rem; line-height: 1.6;">
          Kami menyediakan jasa konsultasi, penyusunan dokumen HIRADC, Manual K3, hingga pendampingan audit eksternal sertifikasi SMK3 PP 50/2012 untuk wilayah <strong>{city.name}</strong> dan sekitarnya.
        </p>
        <p style="margin-bottom: 1rem; line-height: 1.6;">
          Implementasi Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3) berdasarkan Peraturan Pemerintah No. 50 Tahun 2012 adalah kewajiban hukum bagi perusahaan dengan kriteria tertentu di Indonesia. Tim konsultan kami di {city.name} membantu Anda mempermudah proses ini dari nol hingga sertifikat Kemenaker terbit.
        </p>
      </article>

      {cityContent.paragraphs.length > 0 && (
        <section aria-label={`Konteks lokal ${city.name}`} style="line-height: 1.7; font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem;">
          <h2 style="color: var(--text); font-size: 1.3rem; margin: 1rem 0 0.5rem 0;">Konteks Lokal {city.name}</h2>
          {cityContent.paragraphs.map((paragraph) => <p style="margin-bottom: 1rem; line-height: 1.6;">{paragraph.text}</p>)}
        </section>
      )}

      <FAQ items={cityFaqs} title={`FAQ Jasa SMK3 di ${city.name}`} eyebrow={`// FAQ ${city.name.toUpperCase()}`} />
    </div>
  </main>
  <style>.city-service-image { width: 160px; height: 96px; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 8px; }</style>
</BaseLayout>
