---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { cities, regions } from '../../data/cities';
import { getCollection } from 'astro:content';

const title = "Artikel & Panduan K3 — Rujukan Teknis SMK3 & ISO 45001";
const description = "Pusat rujukan teknis, update regulasi, case study implementasi, dan tips praktis keselamatan kerja.";
const articles = await getCollection('articles');
const latestArticles = articles
  .sort((a, b) => (b.data.lastmod || b.data.date).localeCompare(a.data.lastmod || a.data.date))
  .slice(4, 9);
---

<BaseLayout title={title} description={description}>
  <main class="content-section">
    <div style="max-width: 1000px; margin: 0 auto;">
      <header style="margin-bottom: 3rem; text-align: center;">
        <div class="hero-tag">// ARTIKEL & PANDUAN</div>
        <h1 style="font-size: 2.8rem; margin-top: 0.5rem; margin-bottom: 1rem;">Rujukan Teknis K3</h1>
        <p style="color: var(--text-muted); font-size: 1.15rem; max-width: 600px; margin: 0 auto;">
          Kumpulan rujukan lengkap untuk membantu mempercepat proses sertifikasi & kepatuhan regulasi K3 perusahaan Anda.
        </p>
      </header>

      <section style="margin-bottom: 4rem;">
        <div style="background: var(--surface-card); border: 1px solid var(--border); padding: 2rem; border-radius: 8px; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap;">
          <img src="/assets/images/icon-smk3.svg" alt="Diagram Sertifikasi SMK3 Terdekat" width="80" height="80" style="flex-shrink:0;" />
          <div style="flex:1;">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); letter-spacing: 1px;">KATEGORI BARU</span>
            <h2 style="font-size: 1.5rem; color: var(--text); margin-top: 0.25rem; margin-bottom: 0.5rem;">Layanan Konsultan K3 Onsite / Lokal</h2>
            <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1rem; line-height: 1.6;">
              Mencakup pendampingan sertifikasi & penyusunan dokumen wajib per kota di Pulau Jawa dengan respon lokal di bawah 24 jam.
            </p>
            <a href="/artikel/jasa-smk3-terdekat/" class="cta-btn" style="font-size:0.8rem; padding: 0.45rem 1.25rem;">
              Cari Jasa SMK3 Terdekat Onsite &rarr;
            </a>
          </div>
        </div>
      </section>

      <section>
        <h2 style="color: var(--text); font-size: 1.6rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Daftar Artikel per Kategori</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
          <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--accent); font-size: 1.2rem; margin-bottom: 0.75rem;">Regulasi & Hukum K3</h3>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.5;">
              Update dan interpretasi UU No. 1/1970, PP 50/2012, dan Permenaker sektoral untuk jaminan kepatuhan.
            </p>
            <a href="/artikel/kategori/regulasi/" style="color: var(--text); font-size: 0.85rem; font-family: var(--font-mono); text-decoration:none; font-weight:600;">Lihat Arsip Regulasi &rarr;</a>
          </div>

          <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--accent); font-size: 1.2rem; margin-bottom: 0.75rem;">Teknis & Metode K3</h3>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.5;">
              Metodologi praktis penyusunan HIRADC, Job Safety Analysis (JSA), LOTO, dan rencana respon darurat.
            </p>
            <a href="/artikel/kategori/teknis/" style="color: var(--text); font-size: 0.85rem; font-family: var(--font-mono); text-decoration:none; font-weight:600;">Lihat Arsip Teknis &rarr;</a>
          </div>

          <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--accent); font-size: 1.2rem; margin-bottom: 0.75rem;">Case Study</h3>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.5;">
              Kumpulan studi kasus sukses dari proyek konstruksi, manufaktur, dan migas yang kami dampingi.
            </p>
            <a href="/artikel/kategori/case-study/" style="color: var(--text); font-size: 0.85rem; font-family: var(--font-mono); text-decoration:none; font-weight:600;">Lihat Semua Studi Kasus &rarr;</a>
          </div>
        </div>
      </section>

      <section class="latest-articles">
        <div class="section-heading-row">
          <div>
            <div class="section-title">// PILIHAN TERBARU</div>
            <h2>Artikel Terbaru</h2>
          </div>
          <a href="/artikel/" class="card-link">Lihat semua artikel &rarr;</a>
        </div>
        <div class="article-grid">
          {latestArticles.map((article) => (
            <Card
              title={article.data.title}
              description={article.data.description}
              date={article.data.lastmod || article.data.date}
              category={article.data.category}
              readTime={article.data.readTime}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
              href={`/artikel/${article.id}/`}
            />
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
