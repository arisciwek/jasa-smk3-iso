---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';

export async function getStaticPaths() {
  const categories = ['Regulasi', 'Teknis', 'Case Study', 'Tips & Panduan', 'Layanan Lokal'];
  const slugify = (value) => value.toLowerCase().replace(/\s*&\s*/g, '-').replace(/\s+/g, '-');

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryImages = {
  Regulasi: '/assets/images/icon-regulasi.svg',
  Teknis: '/assets/images/icon-teknis.svg',
  'Case Study': '/assets/images/icon-case-study.svg',
  'Tips & Panduan': '/assets/images/icon-tips.svg',
  'Layanan Lokal': '/assets/images/article-lokasi-smk3.svg',
};
const articles = (await getCollection('articles'))
  .filter((article) => article.data.category === category)
  .sort((a, b) => (b.data.lastmod || b.data.date).localeCompare(a.data.lastmod || a.data.date));
const title = `${category} — Artikel K3`;
const description = `Artikel ${category} tentang SMK3, ISO 45001, dan praktik keselamatan kerja.`;
---

<BaseLayout
  title={title}
  description={description}
  image={categoryImages[category] || '/assets/images/page-articles.svg'}
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Artikel', url: '/artikel/' }, { name: category, url: `/artikel/kategori/${Astro.params.category}/` }]}
>
  <main class="content-section category-page">
    <header class="category-header">
      <div class="hero-tag">// {category.toUpperCase()}</div>
      <h1>Rujukan {category}</h1>
      <p>Artikel yang dikurasi untuk membantu memahami dan menjalankan sistem K3 dengan lebih jelas.</p>
    </header>

    <section aria-labelledby="category-articles-heading">
      <h2 id="category-articles-heading">Artikel dalam kategori {category}</h2>
      <div class="article-grid">
        {articles.map((article) => (
          <Card
            title={article.data.title}
            description={article.data.description}
            date={article.data.lastmod || article.data.date}
            category={article.data.category}
            readTime={article.data.readTime}
            image={article.data.image}
            imageAlt={article.data.imageAlt}
            href={`/artikel/${article.id}/`}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .category-page { max-width: 1000px; }
  .category-header { max-width: 720px; margin: 0 auto 3rem; text-align: center; }
  .category-header h1 { margin: 0.75rem 0 1rem; font-size: clamp(2rem, 5vw, 3rem); }
  .category-header p { color: var(--text-muted); font-size: 1.05rem; }
</style>
