---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "ISO 45001:2018 — Sistem Manajemen Keselamatan Kerja Internasional";
const description = "Referensi lengkap standar internasional K3 berbasis struktur High-Level Structure (HLS) dan PDCA.";
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Pendampingan ISO 45001:2018',
  serviceType: 'Konsultasi dan sertifikasi ISO 45001',
  description,
  provider: { '@type': 'Organization', name: 'PT Konsultan K3 Utama' },
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  url: new URL('/iso-45001/', Astro.site ?? Astro.url).href,
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <main class="content-section">
    <div style="max-width: 800px; margin: 0 auto;">
      <header style="margin-bottom: 2.5rem;">
        <div class="hero-tag">// STANDAR INTERNASIONAL</div>
        <h1 style="font-size: 2.5rem; margin-top: 0.5rem; margin-bottom: 1rem;">ISO 45001:2018</h1>
        <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">
          Sistem manajemen keselamatan & kesehatan kerja global untuk mereduksi risiko dan meningkatkan produktivitas.
        </p>
      </header>

      <section style="margin-bottom: 3rem; line-height: 1.7; color: var(--text-muted);">
        <h2 style="color: var(--text); font-size: 1.5rem; margin-bottom: 1rem;">Struktur Klausul ISO 45001</h2>
        <p style="margin-bottom: 1.5rem;">Mengikuti High-Level Structure (HLS) Klausul 4 s/d 10:</p>
        <ul style="margin-left: 1.5rem; margin-bottom: 2rem; list-style-type: square;">
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 4:</strong> Konteks Organisasi</li>
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 5:</strong> Kepemimpinan & Partisipasi Pekerja</li>
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 6:</strong> Perencanaan (Risiko & Peluang)</li>
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 7:</strong> Dukungan (Kompetensi, Komunikasi)</li>
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 8:</strong> Operasional (Eliminasi Bahaya, Perubahan)</li>
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 9:</strong> Evaluasi Kinerja (Audit Internal, Tinjauan Manajemen)</li>
          <li style="margin-bottom: 0.5rem;"><strong>Klausul 10:</strong> Peningkatan (Tindakan Korektif)</li>
        </ul>
      </section>

      <div style="text-align: center; padding: 2rem; background: var(--surface-card); border: 1px solid var(--border); border-radius: 8px;">
        <h3 style="color: var(--text); margin-bottom: 1rem;">Ingin Sertifikasi ISO 45001 Terakreditasi KAN?</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Tim kami membantu gap analysis, penyusunan manual, hingga sukses audit sertifikasi.</p>
        <a href="/tentang/kontak/" class="cta-btn">Mulai Sertifikasi ISO 45001</a>
      </div>
    </div>
  </main>
</BaseLayout>
