---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { citiesByRegion, regions } from '../../data/cities';

const title = 'Peta Situs — SMK3 & ISO 45001 Indonesia';
const description = 'Peta halaman dan rujukan SMK3, ISO 45001, layanan konsultasi, serta artikel berdasarkan wilayah.';
---

<BaseLayout title={title} description={description} image="/assets/images/page-sitemap.svg">
  <main class="content-section human-sitemap">
    <header class="sitemap-intro">
      <div class="hero-tag">// PETA SITUS</div>
      <h1>Temukan halaman yang Anda perlukan.</h1>
      <p>Daftar ini dibuat untuk pembaca. Untuk mesin pencari, gunakan <a href="/sitemap-0.xml">sitemap XML</a>.</p>
    </header>

    <div class="sitemap-primary">
      <section>
        <div class="section-title">// HALAMAN UTAMA</div>
        <ul>
          <li><a href="/">Beranda</a><span>Gambaran cara kami membantu perusahaan</span></li>
          <li><a href="/layanan/">Layanan konsultasi</a><span>Ruang lingkup pendampingan K3</span></li>
          <li><a href="/layanan/smk3/">Implementasi SMK3</a><span>Pendampingan penerapan dan persiapan audit SMK3</span></li>
          <li><a href="/layanan/iso-45001/">Pendampingan ISO 45001</a><span>Implementasi sistem manajemen K3 berbasis PDCA</span></li>
          <li><a href="/layanan/audit-internal/">Audit Internal K3</a><span>Evaluasi kesesuaian dan rencana tindakan perbaikan</span></li>
          <li><a href="/artikel/smk3/">SMK3 PP 50/2012</a><span>Rujukan sistem manajemen K3 nasional</span></li>
          <li><a href="/artikel/iso-45001/">ISO 45001:2018</a><span>Rujukan standar K3 internasional</span></li>
          <li><a href="/artikel/">Artikel & panduan</a><span>Regulasi, metode kerja, dan studi kasus</span></li>
          <li><a href="/tentang/">Tentang kami</a><span>Profil dan pendekatan kerja</span></li>
          <li><a href="/tentang/kontak/">Hubungi konsultan</a><span>Mulai percakapan tentang kebutuhan Anda</span></li>
        </ul>
      </section>

    </div>

    <section class="sitemap-cities">
      <div class="section-heading-row">
        <div><div class="section-title">// LAYANAN BERDASARKAN WILAYAH</div><h2>Rujukan lokal</h2></div>
        <span class="sitemap-count">{regions.length} wilayah · {regions.reduce((total, region) => total + citiesByRegion(region.name).length, 0)} kota</span>
      </div>
      <div class="sitemap-region-grid">
        {regions.map((region) => (
          <section class="sitemap-region">
            <h3>{region.name}</h3>
            <p>{region.blurb}</p>
            <ul>
              {citiesByRegion(region.name).map((city) => (
                <li><a href={`/artikel/jasa-smk3-${city.slug}/`}>Jasa SMK3 {city.name}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sitemap-intro { max-width: 720px; margin: 0 auto 4rem; text-align: center; }
  .sitemap-intro h1 { margin: 0.75rem 0 1rem; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; }
  .sitemap-intro p { color: var(--text-muted); font-size: 1.05rem; }
  .sitemap-intro a, .sitemap-note a, .sitemap-region a { color: var(--accent); }
  .sitemap-primary { max-width: 900px; margin: 0 auto 5rem; }
  .sitemap-primary ul { list-style: none; border-top: 1px solid var(--border); }
  .sitemap-primary li { display: grid; grid-template-columns: minmax(170px, 0.7fr) 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .sitemap-primary li a { color: var(--text); font-weight: 600; text-decoration: none; }
  .sitemap-primary li a:hover { color: var(--accent); }
  .sitemap-primary li span, .sitemap-note p, .sitemap-region p { color: var(--text-muted); font-size: 0.9rem; }
  .sitemap-count { color: var(--text-dim); font-family: var(--font-mono); font-size: 0.75rem; }
  .sitemap-region-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .sitemap-region { padding: 1.35rem; background: var(--surface); }
  .sitemap-region h3 { margin-bottom: 0.4rem; font-size: 1.05rem; }
  .sitemap-region p { min-height: 4.2rem; line-height: 1.5; }
  .sitemap-region ul { display: grid; gap: 0.45rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); list-style: none; }
  .sitemap-region a { font-size: 0.85rem; text-decoration: none; }
  .sitemap-region a:hover { text-decoration: underline; }
  @media (max-width: 768px) {
    .sitemap-primary { margin-bottom: 3.5rem; }
    .sitemap-primary li { grid-template-columns: 1fr; gap: 0.25rem; }
    .sitemap-region-grid { grid-template-columns: 1fr; }
    .sitemap-region p { min-height: 0; }
  }
</style>
