---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { serviceCategories, services } from '../../data/services';

const title = 'Layanan Konsultasi dan Pendampingan Sistem Manajemen';
const description = 'Pendampingan SMK3, ISO, HACCP, akreditasi laboratorium, serta standar industri otomotif dan migas sesuai kebutuhan organisasi.';
const siteUrl = Astro.site ?? Astro.url;
const faqs = [
  { question: 'Apa saja layanan yang tersedia?', answer: 'Kami menyediakan pendampingan SMK3, ISO, HACCP, akreditasi laboratorium, serta standar khusus untuk industri otomotif dan minyak dan gas.' },
  { question: 'Apakah semua layanan berakhir dengan sertifikasi?', answer: 'Tidak selalu. Bentuk layanan disesuaikan dengan standar dan tujuan organisasi, misalnya pendampingan implementasi, kesiapan audit, atau akreditasi laboratorium.' },
  { question: 'Bagaimana menentukan standar yang sesuai?', answer: 'Kami memulai dengan memahami proses bisnis, risiko, kewajiban, kebutuhan pelanggan, dan target organisasi sebelum merekomendasikan ruang lingkup pendampingan.' },
];
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: title,
  serviceType: 'Konsultasi dan pendampingan sistem manajemen', description,
  image: new URL('/assets/images/page-services.svg', siteUrl).href,
  provider: { '@id': `${new URL('/', siteUrl).href}#organization` }, areaServed: { '@type': 'Country', name: 'Indonesia' }, url: new URL('/layanan/', siteUrl).href,
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Katalog layanan sistem manajemen', itemListElement: services.map((service) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service.name, serviceType: service.serviceType, description: service.description, image: new URL(service.image, siteUrl).href, provider: { '@id': `${new URL('/', siteUrl).href}#organization` }, areaServed: { '@type': 'Country', name: 'Indonesia' }, url: new URL(`/layanan/${service.slug}/`, siteUrl).href } })) },
};
---

<BaseLayout title={title} description={description} image="/assets/images/page-services.svg" images={['/assets/images/service-smk3.svg', '/assets/images/service-iso-45001.svg']} breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Layanan', url: '/layanan/' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <main class="content-section services-page">
    <header class="services-intro">
      <div class="hero-tag">// RUANG LINGKUP LAYANAN</div>
      <h1>Layanan yang mengikuti kebutuhan organisasi</h1>
      <p>Mulai dari kepatuhan K3 hingga sistem manajemen khusus industri, kami membantu memetakan kebutuhan, membangun sistem, dan menyiapkan organisasi menghadapi proses penilaian yang relevan.</p>
    </header>
    <section aria-labelledby="service-catalog-heading">
      <div class="section-heading-row"><div><div class="section-title">Katalog layanan</div><h2 id="service-catalog-heading">Standar yang kami dampingi</h2></div><span class="service-count">{services.length} layanan</span></div>
      <div class="service-directory">
        {serviceCategories.map((category) => (
          <section class="service-directory-group" aria-labelledby={`category-${category.name}`}>
            <div class="service-directory-heading"><h3 id={`category-${category.name}`}>{category.name}</h3><p>{category.description}</p></div>
            <div class="service-directory-list">
              {category.services.map((service) => (
                <a href={`/layanan/${service.slug}/`} class="service-directory-item"><img src={service.image} alt={`Ilustrasi layanan ${service.name} untuk ${service.category}`} width="96" height="54" /><span><strong>{service.name}</strong><em>{service.summary}</em></span><b aria-hidden="true">→</b></a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
    <section class="service-contact-panel" aria-labelledby="service-contact-heading"><div><div class="section-title">Ruang lingkup belum pasti?</div><h2 id="service-contact-heading">Kita mulai dari kondisi organisasi Anda.</h2><p>Konsultasi awal membantu menentukan standar, tahapan kerja, dan bukti penerapan yang benar-benar relevan.</p></div><a href="/tentang/kontak/" class="cta-btn">Konsultasikan Kebutuhan</a></section>
    <FAQ items={faqs} title="FAQ Layanan" eyebrow="// PERTANYAAN UMUM" />
  </main>
  <style>
    .services-intro { max-width: 760px; margin-bottom: 4rem; } .services-intro h1 { max-width: 720px; margin: 0.75rem 0 1rem; font-size: clamp(2.2rem, 5vw, 3.5rem); line-height: 1.08; letter-spacing: -1.5px; } .services-intro p { max-width: 680px; color: var(--text-muted); font-size: 1.08rem; } .service-count { color: var(--text-dim); font-family: var(--font-mono); font-size: 0.75rem; }
    .service-directory { display: grid; gap: 3rem; } .service-directory-group { display: grid; grid-template-columns: minmax(210px, 0.55fr) minmax(0, 1.45fr); gap: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); } .service-directory-heading h3 { font-size: 1.2rem; } .service-directory-heading p { margin-top: 0.45rem; color: var(--text-muted); font-size: 0.88rem; } .service-directory-list { border-top: 1px solid var(--border); } .service-directory-item { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 1.5rem; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border); } .service-directory-item img { display: block; width: 6rem; height: 3.4rem; object-fit: cover; border: 1px solid var(--border); border-radius: 5px; background: var(--surface); } .service-directory-item strong, .service-directory-item em { display: block; } .service-directory-item strong { font-size: 1rem; } .service-directory-item em { margin-top: 0.15rem; color: var(--text-muted); font-size: 0.85rem; font-style: normal; } .service-directory-item b { color: var(--accent); font-size: 1.1rem; } .service-directory-item:hover strong { color: var(--accent); }
    .service-contact-panel { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 4rem; padding: 2rem; background: var(--surface-card); border: 1px solid var(--border); border-radius: 8px; } .service-contact-panel h2 { margin: 0.35rem 0 0.5rem; font-size: 1.45rem; } .service-contact-panel p { max-width: 600px; color: var(--text-muted); } @media (max-width: 640px) { .service-directory-group { grid-template-columns: 1fr; gap: 1rem; } .service-directory-item { grid-template-columns: 4.5rem minmax(0, 1fr) 1rem; gap: 0.7rem; } .service-directory-item img { width: 4.5rem; height: 3rem; } .service-contact-panel { align-items: flex-start; flex-direction: column; } }
  </style>
</BaseLayout>
