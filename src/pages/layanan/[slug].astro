---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.filter((service) => !['smk3', 'iso-45001'].includes(service.slug)).map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const title = `${service.name} — Layanan Pendampingan`;
const description = service.description;
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: service.name, serviceType: service.serviceType, description,
  image: new URL(service.image, siteUrl).href, provider: { '@id': `${new URL('/', siteUrl).href}#organization` },
  areaServed: { '@type': 'Country', name: 'Indonesia' }, url: new URL(`/layanan/${service.slug}/`, siteUrl).href,
};
const faqs = service.slug === 'iso-9001' ? [
  { question: 'APA ITU ISO 9001:2015?', answer: 'ISO 9001:2015 adalah standar sistem manajemen mutu yang membantu organisasi mengendalikan proses, memenuhi persyaratan pelanggan dan peraturan yang berlaku, serta meningkatkan kinerja secara berkelanjutan. Standar ini menilai sistem manajemen organisasi, bukan mengesahkan mutu suatu produk secara langsung.' },
  { question: 'APA TUJUAN SERTIFIKASI ISO 9001:2015?', answer: 'Tujuannya adalah membantu organisasi membangun proses yang konsisten, memenuhi kebutuhan pelanggan, mengendalikan risiko dan peluang, memenuhi kewajiban yang relevan, serta menyediakan dasar untuk perbaikan berkelanjutan.' },
  { question: 'APA MANFAAT ISO 9001:2015?', answer: 'Manfaatnya dapat mencakup proses yang lebih terkendali, kepuasan pelanggan yang lebih baik, pembagian tanggung jawab yang lebih jelas, pengambilan keputusan berbasis bukti, pengurangan ketidaksesuaian, dan peningkatan kredibilitas organisasi.' },
  { question: 'PROSES SERTIFIKASI ISO 9001:2015', answer: 'Proses umumnya dimulai dari penentuan ruang lingkup dan tinjauan kesiapan, dilanjutkan penerapan sistem, audit internal, tinjauan manajemen, serta audit sertifikasi oleh lembaga sertifikasi yang dipilih. Temuan audit perlu ditangani dengan bukti tindakan korektif sesuai ketentuan lembaga sertifikasi.' },
  { question: 'APA SAJA PERSYARATAN TAMBAHAN DALAM ISO 9001:2015 UNTUK SMM?', answer: 'ISO 9001:2015 menekankan konteks organisasi dan pihak berkebentingan, pemikiran berbasis risiko, pengendalian proses, kompetensi, informasi terdokumentasi, evaluasi kinerja, audit internal, dan peningkatan. Penerapannya disesuaikan dengan konteks, ukuran, serta kompleksitas organisasi.' },
  { question: 'PENILAIAN TERHADAP ISO 9001:2015', answer: 'Penilaian dapat mencakup tinjauan aplikasi dan ruang lingkup, audit tahap 1 untuk kesiapan, audit tahap 2 untuk penerapan, penutupan ketidaksesuaian, serta audit pengawasan setelah sertifikasi. Audit khusus atau perluasan ruang lingkup dapat dilakukan bila diperlukan.' },
  { question: 'BERAPA BIAYA AUDIT ISO 9001:2015?', answer: 'Biaya tidak dapat ditentukan dengan satu angka karena bergantung pada jumlah personel, lokasi, kompleksitas proses, ruang lingkup, jumlah hari audit, dan kebutuhan perjalanan atau akomodasi. Penawaran sebaiknya disusun setelah informasi organisasi dan ruang lingkup ditinjau.' },
] : [
  { question: `Apa fokus layanan ${service.name}?`, answer: service.description },
  { question: 'Bagaimana tahap awal pendampingan?', answer: 'Pendampingan dimulai dengan memahami proses organisasi, kondisi penerapan, risiko, dokumen, dan target penilaian sebelum ruang lingkup kerja disepakati.' },
  { question: 'Apakah layanan dapat disesuaikan?', answer: 'Ya. Ruang lingkup pendampingan disesuaikan dengan ukuran organisasi, kompleksitas proses, lokasi, tingkat kesiapan, dan kebutuhan pelanggan.' },
];

---

<BaseLayout
  title={title}
  description={description}
  image={service.image}
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Layanan', url: '/layanan/' }, { name: service.name, url: `/layanan/${service.slug}/` }]}
  footerBrandDescription={`PT. PEI Sinergi Indonesia menyelenggarakan jasa ${service.name}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <main class="content-section service-detail-page">
    <header class="service-detail-header"><div class="hero-tag">// {service.category.toUpperCase()}</div><h1>{service.name}</h1><p>{service.description}</p></header>
    <div class="service-detail-grid">
      <img src={service.image} alt={`Ilustrasi pendampingan ${service.name} untuk ${service.category}`} width="640" height="360" />
      <section aria-labelledby="scope-heading"><div class="section-title">Ruang lingkup</div><h2 id="scope-heading">Pendampingan yang dapat disusun bersama</h2><ul>{service.scope.map((item) => <li>{item}</li>)}</ul></section>
    </div>
    <div class="service-detail-sections">
      <section aria-labelledby="about-heading"><div class="section-title">Informasi umum</div><h2 id="about-heading">Tentang {service.name}</h2><p>{service.description} Layanan disusun berdasarkan konteks organisasi, proses yang berjalan, dan tingkat kesiapan yang ditemukan pada tahap awal.</p></section>
      <section aria-labelledby="benefit-heading"><div class="section-title">Nilai penerapan</div><h2 id="benefit-heading">Apa yang ingin dicapai?</h2><ul><li>Memahami persyaratan yang relevan terhadap proses organisasi.</li><li>Membangun pengendalian yang dapat dibuktikan melalui rekaman dan praktik kerja.</li><li>Meningkatkan kesiapan menghadapi audit, penilaian, atau evaluasi pelanggan.</li></ul></section>
      <section aria-labelledby="process-heading"><div class="section-title">Tahapan kerja</div><h2 id="process-heading">Dari pemetaan hingga evaluasi</h2><ol><li>Memahami kebutuhan, ruang lingkup, dan kondisi awal organisasi.</li><li>Memetakan gap serta menyusun prioritas dan rencana kerja.</li><li>Mendampingi penerapan, pelatihan, dan pengendalian yang diperlukan.</li><li>Melakukan evaluasi internal dan menyiapkan tindak lanjut.</li></ol></section>
      <section aria-labelledby="assessment-heading"><div class="section-title">Penilaian</div><h2 id="assessment-heading">Ruang lingkup penawaran disesuaikan</h2><p>Biaya dan durasi tidak ditentukan secara seragam. Keduanya bergantung pada ukuran organisasi, lokasi, kompleksitas proses, jumlah personel, serta target penilaian atau sertifikasi.</p></section>
    </div>
    <section class="service-next-step"><div><div class="section-title">Langkah berikutnya</div><h2>Petakan kebutuhan organisasi Anda.</h2><p>Kami membantu menerjemahkan kebutuhan standar menjadi rencana kerja yang dapat diterapkan.</p></div><a href="/tentang/kontak/" class="cta-btn">Konsultasikan Layanan</a></section>
    <FAQ items={faqs} title={`FAQ ${service.name}`} eyebrow="// PERTANYAAN UMUM" />

    <RelatedArticles serviceSlug={service.slug} />
  </main>
</BaseLayout>